'use client';

import { useState, useEffect } from 'react';
import { supabase } from '@/lib/supabase';
import { ShoppingCart, ShieldCheck, Zap, User, Wallet } from 'lucide-react';

interface Account {
  id: string;
  title: string;
  price: number;
  category: string;
  status: string;
}

export default function Home() {
  const [accounts, setAccounts] = useState<Account[]>([]);
  const [balance, setBalance] = useState<number>(0);
  const [loading, setLoading] = useState<boolean>(true);

  useEffect(() => {
    async function loadAccounts() {
      const { data } = await supabase
        .from('accounts')
        .select('id, title, price, category, status')
        .eq('status', 'AVAILABLE');
      if (data) setAccounts(data);
      setLoading(false);
    }
    loadAccounts();
  }, []);

  const handleBuy = (acc: Account) => {
    alert(`Bạn đang chọn mua: ${acc.title}\nGiá: ${Number(acc.price).toLocaleString()}đ\nVui lòng nạp tiền vào ví để hoàn tất.`);
  };

  return (
    <div className="min-h-screen pb-16">
      {/* Header */}
      <header className="bg-slate-800 border-b border-slate-700 sticky top-0 z-50">
        <div className="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
          <div className="font-black text-xl tracking-wider text-red-500">
            TRUMACCREG<span className="text-white">.SHOP</span>
          </div>
          <div className="flex items-center gap-3">
            <div className="flex items-center gap-1 bg-slate-900 px-3 py-1.5 rounded-full border border-slate-700 text-sm">
              <Wallet className="w-4 h-4 text-emerald-400" />
              <span className="font-semibold text-emerald-400">{balance.toLocaleString()}đ</span>
            </div>
            <button className="bg-red-600 hover:bg-red-700 px-3 py-1.5 rounded-lg text-sm font-bold flex items-center gap-1">
              <User className="w-4 h-4" /> Đăng nhập
            </button>
          </div>
        </div>
      </header>

      {/* Banner & Thông báo */}
      <div className="max-w-5xl mx-auto px-4 mt-4">
        <div className="bg-gradient-to-r from-red-600 to-amber-600 p-4 rounded-xl shadow-lg">
          <h1 className="text-lg font-bold">HỆ THỐNG BÁN ACC LIÊN QUÂN REG TỰ ĐỘNG 24/7</h1>
          <p className="text-xs text-red-100 mt-1">Trắng thông tin 100% • Bảo hành đổi trả • Nhận tài khoản ngay sau khi thanh toán</p>
        </div>

        {/* Cam kết shop */}
        <div className="grid grid-cols-3 gap-2 mt-3 text-center">
          <div className="bg-slate-800 p-2.5 rounded-lg border border-slate-700">
            <Zap className="w-5 h-5 text-amber-400 mx-auto" />
            <span className="text-[11px] font-medium block mt-1">Trả Nick 3 Giây</span>
          </div>
          <div className="bg-slate-800 p-2.5 rounded-lg border border-slate-700">
            <ShieldCheck className="w-5 h-5 text-emerald-400 mx-auto" />
            <span className="text-[11px] font-medium block mt-1">Trắng Thông Tin</span>
          </div>
          <div className="bg-slate-800 p-2.5 rounded-lg border border-slate-700">
            <Wallet className="w-5 h-5 text-blue-400 mx-auto" />
            <span className="text-[11px] font-medium block mt-1">VietQR Tự Động</span>
          </div>
        </div>

        {/* Danh sách Nick */}
        <div className="mt-6">
          <h2 className="text-base font-bold flex items-center gap-2 mb-3">
            <ShoppingCart className="w-5 h-5 text-red-500" /> DANH SÁCH ACC CÓ SẴN
          </h2>

          {loading ? (
            <div className="text-center py-10 text-slate-400 text-sm">Đang tải kho nick...</div>
          ) : accounts.length === 0 ? (
            <div className="bg-slate-800 border border-slate-700 rounded-xl p-8 text-center text-slate-400 text-sm">
              Hiện chưa có tài khoản nào được đăng lên. Bạn có thể thêm nick từ bảng quản trị Supabase.
            </div>
          ) : (
            <div className="grid grid-cols-2 md:grid-cols-3 gap-3">
              {accounts.map((acc) => (
                <div key={acc.id} className="bg-slate-800 rounded-xl border border-slate-700 p-3 flex flex-col justify-between">
                  <div>
                    <span className="bg-red-500/20 text-red-400 text-[10px] px-2 py-0.5 rounded font-bold uppercase">
                      {acc.category}
                    </span>
                    <h3 className="font-semibold text-sm mt-2 line-clamp-2">{acc.title}</h3>
                  </div>
                  <div className="mt-3 pt-3 border-t border-slate-700 flex items-center justify-between">
                    <span className="text-red-400 font-bold text-sm">{Number(acc.price).toLocaleString()}đ</span>
                    <button 
                      onClick={() => handleBuy(acc)}
                      className="bg-red-600 hover:bg-red-700 px-3 py-1 rounded text-xs font-bold"
                    >
                      Mua ngay
                    </button>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
